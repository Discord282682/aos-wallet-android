<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. Same reasoning as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wallet_secure_prefs.xml" />
        <exclude domain="sharedpref" path="wallet_secure_prefs_v2.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wallet_secure_prefs.xml" />
        <exclude domain="sharedpref" path="wallet_secure_prefs_v2.xml" />
    </device-transfer>
</data-extraction-rules>
